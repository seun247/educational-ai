PORT=5000
NODE_ENV=development

# URL of the deployed frontend, used for CORS. In development this can be
# left unset (CORS falls back to allowing all origins).
FRONTEND_URL=http://localhost:3000

# Same Atlas cluster/user as the other projects, different database name
# (eduai) in the path. Put the REAL connection string only in your local
# .env or in Render's environment variables — never here.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.q93balm.mongodb.net/eduai?retryWrites=true&w=majority

# Get this from https://openrouter.ai/keys. Put the REAL key only in your
# local .env or in Render's environment variables — never here.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
